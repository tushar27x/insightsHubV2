# Copy to .env.local. NEXT_PUBLIC_* values are inlined at build time.

# 1 = serve every /api/* call from public/fixtures/ (no backend needed).
NEXT_PUBLIC_MOCK=1
# 1 = call the real hero/preferences endpoints (once backend B5 lands); until then they use fixtures.
NEXT_PUBLIC_HERO_API=0
# The login link goes straight to the backend (the OAuth state cookie lives there).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
