{
  "name": "ih-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:mock && npm run test:web",
    "test:mock": "E2E_SUITE=mock playwright test",
    "test:web": "E2E_SUITE=web playwright test",
    "test:fullstack": "E2E_SUITE=web E2E_FULLSTACK=1 playwright test --project=fullstack",
    "typecheck": "tsc -p ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
